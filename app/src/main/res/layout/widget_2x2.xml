<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="6dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_account" android:layout_width="0dp" android:layout_height="14dp" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:text="—" android:textColor="@color/widget_text_secondary" android:textSize="11sp" android:layout_weight="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="wrap_content" android:layout_height="14dp" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:text="刷新" android:textColor="@color/widget_text_primary" android:textSize="10sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="17dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_balance_label" android:layout_width="0dp" android:layout_height="12dp" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:text="—" android:textColor="@color/widget_text_secondary" android:textSize="10sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:layout_weight="1" />
            <TextView android:id="@+id/widget_balance" android:layout_width="wrap_content" android:layout_height="17dp" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:text="—" android:textColor="@color/widget_text_primary" android:textSize="16sp" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/widget_balance_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginTop="1dp" android:max="100" android:visibility="gone" android:progressDrawable="@drawable/widget_quota_progress" />
        <TextView android:id="@+id/widget_balance_reset" android:layout_width="match_parent" android:layout_height="10dp" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:text="—" android:textColor="@color/widget_text_secondary" android:textSize="8sp" android:layout_marginTop="1dp" android:visibility="gone" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="8sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="17dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_usage_label" android:layout_width="0dp" android:layout_height="12dp" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:text="—" android:textColor="@color/widget_text_secondary" android:textSize="10sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:layout_weight="1" />
            <TextView android:id="@+id/widget_usage" android:layout_width="wrap_content" android:layout_height="17dp" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:text="—" android:textColor="@color/widget_text_primary" android:textSize="16sp" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/widget_usage_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginTop="1dp" android:max="100" android:visibility="gone" android:progressDrawable="@drawable/widget_quota_progress" />
        <TextView android:id="@+id/widget_usage_reset" android:layout_width="match_parent" android:layout_height="10dp" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:text="—" android:textColor="@color/widget_text_secondary" android:textSize="8sp" android:layout_marginTop="1dp" android:visibility="gone" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="8sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_peak_status" android:layout_width="match_parent" android:layout_height="10dp" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:text="—" android:textColor="@color/widget_text_secondary" android:textSize="8sp" android:visibility="gone" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="8sp" android:autoSizeStepGranularity="1sp" />
    <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="10dp" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:text="—" android:textColor="@color/widget_text_secondary" android:textSize="8sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="8sp" android:autoSizeStepGranularity="1sp" />
</LinearLayout>